# 把此文件复制为 .env 并填入你的 API key
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# 可选: 默认拉取天数和IF门槛
DAYS=7
IF_MIN=5

# ── 性能(可选)──
# AI_CONCURRENCY=10          # 同时调用 Claude 的条数(默认 10)
# FETCH_CONCURRENCY=8        # 同时抓取的新闻源数量(默认 8)
# AI_TRIAGE_MODEL=claude-haiku-4-5-20251001   # 新闻先用 Haiku 做相关性初筛,设为空字符串可关闭
# AI_TRIAGE_BATCH_SIZE=20    # 每次 Haiku 初筛的新闻数，批量请求可明显减少网络往返
# AI_TRIAGE_CONCURRENCY=5    # 同时执行的初筛批次数
